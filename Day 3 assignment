!8. Redistribute routes

!EIGRP and OSPF
!R4
conf t
router ospf 1
redistribute eigrp 100 subnets
exit
router eigrp 100
redistribute ospf 1 metric 10000 100 255 1 1500
end

!!redistribute ospf 1 metric bw dly-1zero reliability load MTU

!BGP+OSPF route propagation
!R1
conf t
router ospf 1
default-information originate always
end

!9. NAT
P1 = 209.9.9.10
P2 = 209.9.9.20
S1 = 207.7.7.10
S2 = 208.8.8.10

!R1
conf t
int range e1/1-3
ip nat outside
int e1/0
ip nat inside
!
access-list 1 permit 10.0.0.0 0.255.255.255
access-list 1 permit 172.16.0.0 0.15.255.255
access-list 1 permit 192.168.0.0 0.0.255.255
!
ip nat inside source static 10.2.1.101 209.9.9.10
ip nat inside source static 10.2.1.102 209.9.9.20
ip nat inside source static 192.168.1.133 207.7.7.10
ip nat inside source static 10.2.2.133 208.8.8.10

!!allow all our device to internet internet
ip nat inside source list 1 int e1/2 overload
end

!ip nat inside source list 1 - any packets to enter R1 interface and matches permitted traffic/list:
!access-list 1 permit 10.0.0.0 0.255.255.255
!access-list 1 permit 172.16.0.0 0.15.255.255
!access-list 1 permit 192.168.0.0 0.0.255.255

!int e1/2 overload - convert source IP of the packet to the public IP of R1 e1/2 interface and overload will utilize ports to determine traffic



!!class a ipv4 range - 10.0.0.0 - 10.255.255.255
!!class b ipv4 range - 172.16.0.0 - 172.31.255.255
!!class c ipv4 range - 192.168.0.0 - 192.168.255.255

